<div class="pdnc-premium-window pdnc-climate-list">
    <header>
        <h1>{{localize "PDNC.CustomClimate.ListTitle"}}</h1>
    </header>
    
    <div class="pdnc-scrollable">
    {{#if (eq climates.length 0)}}
        <p class="notes text-center">{{localize "PDNC.CustomClimate.NoClimates"}}</p>
    {{else}}
        <ul class="pdnc-climate-ul">
            {{#each climates}}
            <li class="pdnc-climate-li flexrow" data-id="{{this.id}}">
                <span class="climate-name">{{this.name}}</span>
                <div class="climate-controls">
                    <button type="button" class="icon-button" data-action="edit" title="Edit"><i class="fas fa-edit"></i></button>
                    <button type="button" class="icon-button" data-action="delete" title="Delete"><i class="fas fa-trash"></i></button>
                </div>
            </li>
            {{/each}}
        </ul>
    {{/if}}
    </div>

    <footer class="sheet-footer flexrow">
        <button type="button" data-action="create">
            <i class="fas fa-plus"></i> {{localize "PDNC.CustomClimate.Create"}}
        </button>
        <button type="button" data-action="export">
            <i class="fas fa-file-export"></i> Export
        </button>
        <button type="button" data-action="import">
            <i class="fas fa-file-import"></i> Import
        </button>
    </footer>
</div>
