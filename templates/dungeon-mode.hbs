<div class="pdnc-premium-window pdnc-dungeon-mode">
    <header class="pdnc-header">
        <h2>
            <i class="fas fa-dungeon"></i> {{localize "PDNC.DungeonMode.Title"}}
        </h2>
        <p class="pdnc-notes">{{localize "PDNC.DungeonMode.Subtitle"}}</p>
    </header>

    <div class="pdnc-form-group">
        <label>{{localize "PDNC.DungeonMode.DisableLighting"}}</label>
        <div class="pdnc-form-fields">
            <input type="checkbox" name="disableLighting" {{checked disableLighting}}>
        </div>
    </div>
    <p class="pdnc-notes pdnc-hint">
        {{localize "PDNC.DungeonMode.DisableLightingHint"}}
    </p>

    <div class="pdnc-form-group">
        <label>{{localize "PDNC.DungeonMode.DisableWeather"}}</label>
        <div class="pdnc-form-fields">
            <input type="checkbox" name="disableWeather" {{checked disableWeather}}>
        </div>
    </div>
    <p class="pdnc-notes pdnc-hint">
        {{localize "PDNC.DungeonMode.DisableWeatherHint"}}
    </p>

    <footer class="pdnc-sheet-footer">
        <button type="button" data-action="save" class="pdnc-save-button">
            <i class="fas fa-check"></i> {{localize "PDNC.Apply"}}
        </button>
    </footer>
</div>
