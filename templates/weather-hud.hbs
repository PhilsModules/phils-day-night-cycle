<div class="weather-hud-container">
    <div id="weather-preview-box" class="weather-preview-box">
        <!-- Controls Overlay -->
        <div class="weather-overlay-controls">
            <!-- Pause Button -->
            <button type="button" class="weather-pause-btn" title="{{localize 'PDNC.Tooltips.PausePreview'}}">
                <i class="fas fa-pause"></i>
            </button>
            
            <!-- Global Button -->
            <button type="button" class="weather-global-btn" title="{{localize 'PDNC.Tooltips.ToggleGlobalWeather'}}">
                <i class="fas fa-globe"></i>
            </button>
            
            <button type="button" class="weather-close-btn" title="{{localize 'PDNC.Close'}}">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <!-- PIXI Canvas will be injected here -->
    </div>
</div>
