<div class="pdnc-weather-config-content" style="height: 100%; display: flex; flex-direction: column;">
    
    {{!-- Premium Header --}}
    <header class="pdnc-header" style="margin-bottom: 5px; flex-shrink: 0;">
        <h1 style="font-size: 1.5em; margin: 0; border: none; padding: 0;">{{localize "PDNC.WeatherConfig.Title"}}</h1>
        <p class="pdnc-notes" style="margin: 0; opacity: 0.7; font-size: 0.85em;">{{localize "PDNC.WeatherConfig.Subtitle"}}</p>
    </header>

    <div class="pdnc-scrollable-content" style="flex: 1; overflow-y: auto; padding-right: 5px;">
        
        {{!-- Info Block --}}
        <div class="pdnc-info-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; background: rgba(255,255,255,0.03); padding: 8px; border-radius: 4px; border: 1px solid rgba(197, 160, 89, 0.2); margin-bottom: 15px;">
            <div>
                <label style="display: block; font-size: 0.8em; opacity: 0.7; text-transform: uppercase;">{{localize "PDNC.WeatherConfig.Climate"}}</label>
                <div style="font-weight: bold; color: #c5a059;">{{climate}}</div>
            </div>
            <div>
                <label style="display: block; font-size: 0.8em; opacity: 0.7; text-transform: uppercase;">{{localize "PDNC.WeatherConfig.Season"}}</label>
                <div style="font-weight: bold; color: #c5a059;">{{season}}</div>
            </div>
        </div>

        {{!-- Description --}}
        <div class="pdnc-form-group">
            <label>{{localize "PDNC.WeatherConfig.Description"}}</label>
            <div class="form-fields">
                <input type="text" name="description" value="{{weather.description}}" placeholder="e.g. Sunny with light breeze" style="width: 100%;">
            </div>
        </div>

        {{!-- FX & Temperature --}}
        <div class="pdnc-form-group">
            <label>{{localize "PDNC.WeatherConfig.FX"}}</label>
            <div class="form-fields" style="display: flex; gap: 5px;">
                <select name="fx" style="flex: 1;">
                    {{selectOptions fxChoices selected=weather.fx blank=noneLabel}}
                </select>
                <button type="button" data-action="open-mixer" title="{{localize 'PDNC.WeatherMixer.Title'}}" class="pdnc-icon-button" style="flex: 0 0 30px;">
                    <i class="fas fa-flask"></i>
                </button>
            </div>
        </div>

        <div class="pdnc-form-group">
            <label>{{localize "PDNC.WeatherConfig.Temperature"}} ({{unit}})</label>
            <div class="form-fields" style="display: flex; gap: 15px;">
                <div style="display: flex; align-items: center; gap: 5px; flex: 1;">
                    <span style="opacity: 0.7; font-size: 0.9em;">Min</span>
                    <input type="number" name="tempMin" value="{{weather.displayMin}}" style="flex: 1; text-align: center;">
                </div>
                <div style="display: flex; align-items: center; gap: 5px; flex: 1;">
                    <span style="opacity: 0.7; font-size: 0.9em;">Max</span>
                    <input type="number" name="tempMax" value="{{weather.displayMax}}" style="flex: 1; text-align: center;">
                </div>
            </div>
        </div>

    </div>

    <footer class="pdnc-sheet-footer" style="margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(197, 160, 89, 0.3); display: flex; justify-content: space-between; flex-shrink: 0; gap: 10px;">
        <button type="button" data-action="reroll" style="flex: 1;">
            <i class="fas fa-dice"></i> {{localize "PDNC.WeatherConfig.Reroll"}}
        </button>
        <button type="submit" data-action="apply" class="save" style="flex: 1; background: rgba(197, 160, 89, 0.2); border-color: #c5a059;">
            <i class="fas fa-check"></i> {{localize "PDNC.WeatherConfig.Apply"}}
        </button>
    </footer>
</div>
